{
  "schema_version": 1,
  "id": "rhi.visual-spec.v1",
  "runtime_dependency": false,
  "package_ownership": "domain-local",
  "visual_classes": {
    "hero_scene": {
      "width": 2400,
      "height": 800,
      "aspect_ratio": "3:1",
      "transparent_background": false,
      "requires_focal_point": true,
      "requires_safe_area": true
    },
    "product_wide": {
      "width": 1600,
      "height": 950,
      "transparent_background": true
    },
    "product_square": {
      "width": 1400,
      "height": 1400,
      "transparent_background": true
    },
    "product_landscape": {
      "width": 1600,
      "height": 1200,
      "transparent_background": true
    }
  },
  "families": [
    "hero",
    "product",
    "generic_fallback"
  ],
  "quality_values": [
    "verified_product",
    "verified_appearance",
    "representative_brand",
    "representative_generic",
    "generic_family",
    "derived_appearance",
    "deprecated"
  ],
  "product_search_order": [
    "sku",
    "brand_model",
    "brand_type",
    "official_manufacturer",
    "authorised_distributor",
    "generated_or_derived"
  ],
  "required_product_metadata": [
    "id",
    "family",
    "visual_class",
    "quality",
    "package_path",
    "width",
    "height",
    "brand",
    "model",
    "search_key_primary",
    "source_kind",
    "status"
  ],
  "required_hero_metadata": [
    "id",
    "family",
    "visual_class",
    "quality",
    "package_path",
    "width",
    "height",
    "hero_key",
    "focal_x",
    "focal_y",
    "safe_left",
    "safe_right",
    "status"
  ],
  "invariants": {
    "hero_must_not_be_generic_fallback": true,
    "domain_assets_remain_package_local": true,
    "core_must_not_own_domain_products": true,
    "verified_product_must_not_use_generic_artwork": true,
    "manifest_is_domain_source_of_truth": true
  },
  "shared_layout": {
    "authority": "rhi-ux-core/src/primitives.css",
    "intent": "one shared standalone shell and photographic hero grammar; content and imagery remain domain-owned",
    "hero_class": "hero_scene",
    "hero_heights_px": {
      "desktop": 146,
      "desktop_compact": 140,
      "tablet": 128,
      "phone": 118
    },
    "hero_breakpoints_max_px": {
      "desktop_compact": 1180,
      "tablet": 760,
      "phone": 430
    },
    "hero_title": "rhi-ux-core tokens and responsive primitives",
    "hero_image_fit": "cover",
    "hero_image_layer": "background",
    "hero_copy_safe_side": "left",
    "protected_consumer_selectors": [
      "rhiUxDomainShell",
      "rhiUxDomainShellTop",
      "rhiUxDomainShellBottom",
      "rhiUxDomainIdentity",
      "rhiUxModuleTabs",
      "rhiUxModuleTab",
      "rhiUxDomainTabs",
      "rhiUxDomainTab",
      "rhiUxCompanyBrand",
      "rhiUxPageHero",
      "rhiUxPageHeroCopy",
      "rhiUxPageHeroArt"
    ]
  }
}
